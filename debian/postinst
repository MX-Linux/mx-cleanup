#!/bin/sh
set -e

case "$1" in
configure)
    # run-parts and Debian cron ignore dotted filenames. Preserve the script
    # contents (including @reboot references to /usr/bin scripts) and modes.
    # This encoding must match userCronSuffix() in usernameutils.h.
    for directory in /etc/cron.daily /etc/cron.weekly /etc/cron.monthly /etc/cron.d; do
        for old in "$directory"/mx-cleanup.*; do
            [ -f "$old" ] && [ ! -L "$old" ] || continue
            # Only migrate files generated by MX Cleanup.
            if ! grep -qF '# This file was created by MX Cleanup' "$old" &&
                ! grep -q '^@reboot root /usr/bin/mx-cleanup-script' "$old"; then
                continue
            fi
            id=${old##*/mx-cleanup.}
            case "$id" in
                ''|*[!a-zA-Z0-9_.-]*) continue ;;
            esac
            id=$(printf '%s' "$id" | sed 's/_/_5f/g; s/\./_2e/g')
            target="$directory/mx-cleanup-$id"
            # Never overwrite an already configured replacement.
            [ ! -e "$target" ] && [ ! -L "$target" ] || continue
            mv -- "$old" "$target"
        done
    done
    ;;
esac

#DEBHELPER#
